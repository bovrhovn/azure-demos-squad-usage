@model SquadDemos.Web.CopilotDynamicModule.Features.Copilot.CopilotAuthenticationStatus

<ul class="account-links">
@if (Model.IsAuthenticated)
{
    <li>
        <img class="account-avatar" src="@Model.AvatarUrl" alt="@Model.Login's GitHub avatar" width="32" height="32" />
    </li>
    <li class="account-name">@Model.Login</li>
}
else
{
    <li>
        <img class="account-avatar" src="@Model.AvatarUrl" alt="Default avatar" width="32" height="32" />
    </li>
    <li class="nav-item">
        <a href="@Model.AuthenticationUrl" target="_blank" rel="noreferrer">Authenticate with GitHub</a>
    </li>
}
</ul>
