@using SquadDemos.Web.CopilotDynamicModule.Features.Chat
@using SquadDemos.Web.CopilotDynamicModule.Features.Copilot
@using Microsoft.Extensions.Options
@inject ICopilotService Copilot
@inject IOptions<ChatStorageOptions> ChatStorage
@{
    var copilotStatus = await Copilot.GetAuthenticationStatusAsync(Context.RequestAborted);
    var storageEnvironment = ChatStorageEnvironment.GetLabel(ChatStorage.Value.ConnectionString);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Copilot Dynamic Module</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header>
        <nav class="site-nav" aria-label="Primary navigation">
            <div class="site-nav-inner">
                <a class="brand" asp-area="" asp-page="/Index">
                    <span class="brand-mark" aria-hidden="true">+</span>
                    <span>
                        <small>GITHUB</small>
                        Copilot Dynamic Module
                    </span>
                </a>
                <div class="site-links">
                    <a asp-area="" asp-page="/Index">Chat</a>
                    <a asp-area="" asp-page="/Profile/Dashboard">Dashboard</a>
                    <a asp-area="" asp-page="/Profile/SkillsUploader">Skills</a>
                    @if (copilotStatus.IsAuthenticated)
                    {
                        <a asp-area="" asp-page="/Profile/ModelSelector">Model</a>
                    }
                    <partial name="_LoginPartial" model="copilotStatus" />
                </div>
            </div>
        </nav>
        <div class="section-rule" aria-hidden="true"></div>
    </header>
    <div class="page-frame">
        <main id="main-content" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="page-frame">
            <span>Copilot Dynamic Module</span>
            <span>GitHub Copilot-backed developer workspace</span>
            <span>Chat storage: Azure Cosmos DB (@storageEnvironment)</span>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
