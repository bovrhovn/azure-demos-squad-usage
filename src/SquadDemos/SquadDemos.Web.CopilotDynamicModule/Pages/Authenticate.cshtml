@page
@model SquadDemos.Web.CopilotDynamicModule.Pages.AuthenticateModel
@{
    ViewData["Title"] = "Authenticate with GitHub";
}

<section class="settings-panel">
    <p class="eyebrow">GITHUB COPILOT</p>
    <h1>Authenticate with GitHub</h1>
    <p>Copilot uses your GitHub account to identify you and provide access to the configured models.</p>
    <ol>
        <li>Select <strong>Authenticate with GitHub</strong> to open GitHub's device sign-in page.</li>
        <li>Sign in to GitHub and approve the GitHub Copilot request.</li>
        <li>Return here and select <strong>Continue to chat</strong>.</li>
    </ol>
    <div class="authentication-actions">
        <a class="button-link" href="@Model.AuthenticationUrl" target="_blank" rel="noreferrer">Authenticate with GitHub</a>
        <a class="button-link secondary-button" asp-page="/Authenticate">Continue to chat</a>
    </div>
</section>
