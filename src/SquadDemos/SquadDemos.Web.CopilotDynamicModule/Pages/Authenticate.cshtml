@page
@{ ViewData["Title"] = "Authenticate with GitHub"; }
<section id="authentication-app" class="settings-panel" v-cloak>
    <p class="eyebrow">GITHUB COPILOT</p><h1>Authenticate with GitHub</h1>
    <p v-if="error" class="error-message">{{ error }}</p>
    <template v-if="authorization"><ol><li>Open GitHub's device sign-in page.</li><li>Enter the activation code and approve the request.</li><li>Return here and select Continue to chat.</li></ol><p class="authentication-code"><strong>{{ authorization.userCode }}</strong></p><p v-if="message" role="status">{{ message }}</p><div class="authentication-actions"><a class="button-link" :href="authorization.verificationUriComplete || authorization.verificationUri" target="_blank" rel="noreferrer">Open GitHub device sign-in</a><button class="secondary-button" @@click="complete">Continue to chat</button></div></template>
    <template v-else><p>Select the button below to generate a device activation code.</p><button class="button-link" :disabled="loading" @@click="begin">Authenticate with GitHub</button></template>
</section>
@section Scripts { <script src="~/js/vue.global.prod.js"></script><script src="~/js/api-endpoints.js"></script><script src="~/js/authenticate.js"></script> }
