@page
@{ ViewData["Title"] = "Model selector"; }
<section id="model-selector-app" class="settings-panel" v-cloak><p class="eyebrow">GITHUB COPILOT</p><h1>Model selector</h1><p>Choose the default model used for new chat requests and dynamic dashboard modules.</p><p v-if="error" class="error-message">{{ error }}</p><form v-on:submit.prevent="save"><label for="model">Default model</label><select id="model" v-model="selectedModel"><option value="">Copilot default</option><option v-for="model in models" :value="model.id">{{ model.name }}</option></select><button type="submit">Save model</button></form><p v-if="status" class="success-message">{{ status }}</p></section>
@section Scripts { <script src="~/js/vue.global.prod.js"></script><script src="~/js/api-endpoints.js"></script><script src="~/js/model-selector.js"></script> }
