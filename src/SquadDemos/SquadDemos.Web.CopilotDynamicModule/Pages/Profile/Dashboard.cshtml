@page
@{
    ViewData["Title"] = "Dashboard";
}

<div id="dashboard-app" class="dashboard-page" v-cloak>
    <div class="dashboard-heading">
        <div>
            <p class="eyebrow">MODULES / RUNTIME VIEW</p>
            <h1>Dynamic dashboard</h1>
        </div>
        <div class="dashboard-actions">
            <input ref="moduleFile" type="file" accept=".dll" class="visually-hidden" v-on:change="uploadModule">
            <button type="button" v-on:click="$refs.moduleFile.click()" :disabled="isLoading || isUploading">
                {{ isUploading ? 'Uploading...' : 'Upload module' }}
            </button>
            <button type="button" v-on:click="loadDashboard(true)" :disabled="isLoading || isUploading">
                {{ isLoading ? 'Loading...' : 'Refresh' }}
            </button>
        </div>
    </div>
    <p class="dashboard-intro">A live view of modules discovered from the runtime folder. Module statistics are updated after every load; generated module content renders in isolated frames.</p>
    <p v-if="error" class="error-message" role="alert">{{ error }}</p>
    <section class="module-creator" aria-labelledby="module-creator-heading">
        <div>
            <p class="eyebrow">COPILOT MODULE CREATOR</p>
            <h2 id="module-creator-heading">Create a dashboard module</h2>
        </div>
        <form v-on:submit.prevent="createModule">
            <label for="module-request">Describe the module to create</label>
            <div class="module-creator-controls">
                <input id="module-request" v-model="moduleRequest" :disabled="isCreating" required
                       placeholder="For example: display a weekly delivery summary.">
                <button type="submit" :disabled="isCreating || isLoading">
                    {{ isCreating ? 'Creating...' : 'Create module' }}
                </button>
            </div>
        </form>
        <div v-if="generationProgress.length > 0" class="module-generation-progress" role="status" aria-live="polite">
            <p class="eyebrow">GENERATION PROGRESS</p>
            <ol>
                <li v-for="progress in generationProgress" :key="progress.stage"
                    :class="{ complete: progress.isComplete, failed: progress.isError }">
                    <strong>{{ progress.stage }}</strong>
                    <span>{{ progress.message }}</span>
                </li>
            </ol>
        </div>
    </section>
    <section class="module-statistics" aria-labelledby="module-statistics-heading" aria-live="polite">
        <div class="module-statistics-heading">
            <p class="eyebrow">MODULE STATISTICS</p>
            <h2 id="module-statistics-heading">Current runtime inventory</h2>
        </div>
        <dl>
            <div>
                <dt>Loaded modules</dt>
                <dd>{{ modules.length }}</dd>
                <p>Modules that completed this load.</p>
            </div>
            <div>
                <dt>Deployed assemblies</dt>
                <dd>{{ moduleFiles.length }}</dd>
                <p>DLLs available in the module folder.</p>
            </div>
            <div>
                <dt>Execution order</dt>
                <dd>{{ moduleOrderRange }}</dd>
                <p>Lowest through highest module order.</p>
            </div>
        </dl>
        <p v-if="modules.length === 0" class="empty-state">No dashboard modules were discovered.</p>
        <ul v-else class="module-name-list" aria-label="Loaded module names">
            <li v-for="module in modules" :key="`${module.order}-${module.name}`">{{ module.name }} <span>Order {{ module.order }}</span></li>
        </ul>
    </section>
    <section class="module-grid" aria-live="polite">
        <iframe v-for="module in modules" :key="`${module.order}-${module.name}`" class="module-frame" sandbox
                :title="`${module.name}, dashboard module ${module.order}`" :srcdoc="module.html"></iframe>
    </section>
    <section class="module-management" aria-labelledby="module-management-heading">
        <div>
            <p class="eyebrow">MODULE MANAGEMENT</p>
            <h2 id="module-management-heading">Deployed modules</h2>
        </div>
        <p v-if="moduleFiles.length === 0" class="empty-state">No uploaded module assemblies are available.</p>
        <ul v-else class="module-file-list">
            <li v-for="moduleFile in moduleFiles" :key="moduleFile">
                <span>{{ moduleFile }}</span>
                <button type="button" class="delete-module" v-on:click="openDeleteDialog(moduleFile)">Delete</button>
            </li>
        </ul>
    </section>
    <dialog ref="deleteDialog" class="delete-dialog" v-on:close="modulePendingDeletion = ''">
        <form method="dialog">
            <h2>Delete module?</h2>
            <p>Delete <strong>{{ modulePendingDeletion }}</strong> from the deployed module folder? This cannot be undone.</p>
            <div class="dialog-actions">
                <button value="cancel">Cancel</button>
                <button class="delete-module" value="confirm" v-on:click.prevent="deleteModule" :disabled="isDeleting">
                    {{ isDeleting ? 'Deleting...' : 'Delete module' }}
                </button>
            </div>
        </form>
    </dialog>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
    <script src="~/js/signalr.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
